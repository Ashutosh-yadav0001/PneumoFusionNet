{
  "phase": 3,
  "description": "Triple Fusion: Image + Text + Clinical Metadata (Exp 5 & 6)",
  "architecture": {
    "image_encoder": "DenseNet121+CBAM (frozen, NIH pretrained \u2014 zero MIMIC overlap)",
    "text_encoder": "Bio_ClinicalBERT (last 2 layers unfrozen)",
    "meta_encoder": "MLP(16->128->128->64)",
    "fusion": "CrossAttention(img queries text, key_padding_mask) + concat meta + MLP classifier",
    "fused_dim": 1600,
    "clinical_feats": [
      "age",
      "gender_M",
      "heart_rate",
      "respiratory_rate",
      "spo2",
      "systolic_bp",
