      "hematocrit",
      "creatinine",
      "crp",
      "alk_phos",
      "albumin",
      "has_vitals"
    ],
    "is_deceased_removed": true,
    "text_fallback_removed": true,
    "key_padding_mask_used": true,
    "p2v2_weights_loaded": true
  },
  "training": {
    "n_train": 2635,
